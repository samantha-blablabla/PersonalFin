# FinTrack Pro VN - Development Environment Variables
# Copy this file to .dev.vars and fill in your actual values
# .dev.vars is gitignored for security

# ============================================================================
# Google Gemini AI API Key
# ============================================================================
# Get your API key from: https://ai.google.dev/
GEMINI_API_KEY=your_gemini_api_key_here

# ============================================================================
# Telegram Bot Token (Future feature)
# ============================================================================
# Get token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# ============================================================================
# CORS Allowed Origins
# ============================================================================
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8787

# ============================================================================
# Database Configuration (D1)
# ============================================================================
# These are automatically provided by Wrangler binding
# DB_NAME=fintrack-db
